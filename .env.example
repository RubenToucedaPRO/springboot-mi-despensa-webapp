#API_KEY cloudinary
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

#Puerto
SERVER_PORT=8081

#Base de datos
DB_URL=jdbc:mysql://localhost:3306/midespensa_bd
DB_USER=your_db_user
DB_PASS=your_db_password

#Correo
SERVER_URL_MAIL=https://localhost:8081
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_app_password

#Configuracion Https para permitir acceso a camara desde navegador
SSL_ENABLE=True
SSL_STORE=classpath:keystore.p12
SSL_PASS=your_ssl_password
SSL_TYPE=PKCS12
SSL_ALIAS=midespensa
